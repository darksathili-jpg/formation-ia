{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darksathili-jpg.github.io/formation-ia/formation_llm/schema/sources.schema.json",
  "title": "Formation LLM — Sources Registry",
  "description": "Registre des sources. status=verified signifie que l'identité et les métadonnées de la source ont été contrôlées ; cela ne transforme pas la source en registre de vérité.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_on", "sources"],
  "$defs": {
    "sourceId": {"type": "string", "pattern": "^SRC-\\d{4}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nonEmpty": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "updated_on": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "source_type", "evidence_role", "publisher", "publisher_kind", "url", "publication_status", "accessed_on", "status", "temporal_stability", "language", "topics"],
        "properties": {
          "id": {"$ref": "#/$defs/sourceId"},
          "title": {"$ref": "#/$defs/nonEmpty"},
          "authors": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
          "source_type": {"type": "string", "enum": ["research-paper", "official-documentation", "law-regulation", "institutional-guidance", "standard-framework", "security-guidance", "benchmark-evaluation", "dataset", "book", "educational-resource", "web-page"]},
          "evidence_role": {"type": "string", "enum": ["primary", "secondary", "tertiary"]},
          "publisher": {"$ref": "#/$defs/nonEmpty"},
          "publisher_kind": {"type": "string", "enum": ["academic", "government", "regulator", "intergovernmental", "standards-body", "vendor", "nonprofit", "publisher", "repository", "other"]},
          "url": {"type": "string", "format": "uri"},
          "archive_url": {"type": "string", "format": "uri"},
          "identifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "doi": {"type": "string", "minLength": 1},
              "arxiv": {"type": "string", "pattern": "^\\d{4}\\.\\d{4,5}$"},
              "celex": {"type": "string", "minLength": 1},
              "isbn": {"type": "string", "minLength": 1},
              "report_number": {"type": "string", "minLength": 1}
            }
          },
          "publication_status": {"type": "string", "enum": ["peer-reviewed", "preprint", "official", "living-document", "not-applicable"]},
          "published_on": {"type": "string", "format": "date"},
          "source_updated_on": {"type": "string", "format": "date"},
          "version": {"type": "string", "minLength": 1},
          "accessed_on": {"type": "string", "format": "date"},
          "status": {"type": "string", "enum": ["verified", "to-review", "deprecated", "archived"]},
          "temporal_stability": {"type": "string", "enum": ["stable", "evolving", "fast-moving"]},
          "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
          "topics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
          "notes": {"type": "string"},
          "supersedes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sourceId"}}
        }
      }
    }
  }
}
