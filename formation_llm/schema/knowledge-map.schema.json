{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darksathili-jpg.github.io/formation-ia/formation_llm/schema/knowledge-map.schema.json",
  "title": "Formation LLM — Knowledge Map",
  "description": "Contrat canonique du référentiel de connaissances. Les axes de stabilité temporelle et de statut épistémique sont séparés ; les définitions canoniques vivent dans le glossaire et les concepts les référencent par term_ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "updated_on",
    "domains",
    "concepts"
  ],
  "$defs": {
    "domainId": {
      "type": "string",
      "pattern": "^[A-Z]$"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[A-Z]\\d{2}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^SRC-\\d{4}$"
    },
    "termId": {
      "type": "string",
      "pattern": "^TERM-\\d{4}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "order",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/domainId"
          },
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/nonEmpty"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "$ref": "#/$defs/nonEmpty"
          }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "title",
          "domain",
          "mastery_level",
          "stability",
          "epistemic_status",
          "summary",
          "prerequisites",
          "learning_objectives",
          "trainer_mastery",
          "misconceptions",
          "source_ids",
          "term_ids",
          "tags",
          "reviewed_on"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/conceptId"
          },
          "slug": {
            "$ref": "#/$defs/slug"
          },
          "title": {
            "$ref": "#/$defs/nonEmpty"
          },
          "domain": {
            "$ref": "#/$defs/domainId"
          },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmpty"
            }
          },
          "mastery_level": {
            "type": "string",
            "enum": [
              "indispensable",
              "intermediate",
              "advanced",
              "expert"
            ]
          },
          "stability": {
            "type": "string",
            "enum": [
              "stable",
              "evolving",
              "fast-moving"
            ]
          },
          "epistemic_status": {
            "type": "string",
            "enum": [
              "established",
              "pedagogical-simplification",
              "debated",
              "model-specific",
              "emerging"
            ]
          },
          "summary": {
            "$ref": "#/$defs/nonEmpty"
          },
          "prerequisites": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/conceptId"
            }
          },
          "learning_objectives": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/nonEmpty"
            }
          },
          "trainer_mastery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "explain",
              "demonstrate",
              "hard_questions"
            ],
            "properties": {
              "explain": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/nonEmpty"
                }
              },
              "demonstrate": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/nonEmpty"
                }
              },
              "hard_questions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "question",
                    "key_points"
                  ],
                  "properties": {
                    "question": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "key_points": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "$ref": "#/$defs/nonEmpty"
                      }
                    }
                  }
                }
              }
            }
          },
          "misconceptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "correction"
              ],
              "properties": {
                "statement": {
                  "$ref": "#/$defs/nonEmpty"
                },
                "correction": {
                  "$ref": "#/$defs/nonEmpty"
                }
              }
            }
          },
          "labs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^LAB-[A-Z0-9-]+$"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/sourceId"
            }
          },
          "term_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/termId"
            }
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/tag"
            }
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
