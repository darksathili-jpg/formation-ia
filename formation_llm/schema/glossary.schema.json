{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darksathili-jpg.github.io/formation-ia/formation_llm/schema/glossary.schema.json",
  "title": "Formation LLM — Glossary",
  "description": "Schéma canonique du glossaire conceptuel de la formation LLM.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "updated_on",
    "terms"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },

    "updated_on": {
      "type": "string",
      "format": "date"
    },

    "terms": {
      "type": "array",

      "items": {
        "type": "object",
        "additionalProperties": false,

        "required": [
          "id",
          "term",
          "slug",
          "definition_short",
          "definition_precise",
          "status",
          "concept_ids",
          "source_ids",
          "tags"
        ],

        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TERM-\\d{4}$"
          },

          "term": {
            "type": "string",
            "minLength": 1
          },

          "english_term": {
            "type": "string",
            "minLength": 1
          },

          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },

          "aliases": {
            "type": "array",
            "uniqueItems": true,

            "items": {
              "type": "string",
              "minLength": 1
            }
          },

          "definition_short": {
            "type": "string",
            "minLength": 1
          },

          "definition_precise": {
            "type": "string",
            "minLength": 1
          },

          "pedagogical_analogy": {
            "type": "string"
          },

          "analogy_limits": {
            "type": "string"
          },

          "not_to_confuse_with": {
            "type": "array",
            "uniqueItems": true,

            "items": {
              "type": "string",
              "pattern": "^TERM-\\d{4}$"
            }
          },

          "common_misuses": {
            "type": "array",

            "items": {
              "type": "string",
              "minLength": 1
            }
          },

          "status": {
            "type": "string",
            "enum": [
              "stable",
              "evolving",
              "contested"
            ]
          },

          "concept_ids": {
            "type": "array",
            "uniqueItems": true,

            "items": {
              "type": "string",
              "pattern": "^[A-M]\\d{2}$"
            }
          },

          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,

            "items": {
              "type": "string",
              "pattern": "^SRC-\\d{4}$"
            }
          },

          "tags": {
            "type": "array",
            "uniqueItems": true,

            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },

          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}