{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darksathili-jpg.github.io/formation-ia/formation_llm/schema/glossary.schema.json",
  "title": "Formation LLM — Glossary",
  "description": "Glossaire canonique. Les définitions terminologiques vivent ici ; la carte de connaissances référence les termes par term_ids afin d'éviter les doubles sources de vérité.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated_on", "language", "terms"],
  "$defs": {
    "termId": {"type": "string", "pattern": "^TERM-\\d{4}$"},
    "sourceId": {"type": "string", "pattern": "^SRC-\\d{4}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nonEmpty": {"type": "string", "minLength": 1}
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "updated_on": {"type": "string", "format": "date"},
    "language": {"type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"},
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "term", "slug", "definition_short", "definition_precise", "stability", "epistemic_status", "source_ids", "tags", "reviewed_on"],
        "properties": {
          "id": {"$ref": "#/$defs/termId"},
          "term": {"$ref": "#/$defs/nonEmpty"},
          "english_term": {"$ref": "#/$defs/nonEmpty"},
          "slug": {"$ref": "#/$defs/slug"},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
          "definition_short": {"$ref": "#/$defs/nonEmpty"},
          "definition_precise": {"$ref": "#/$defs/nonEmpty"},
          "scope_note": {"type": "string", "minLength": 1},
          "pedagogical_analogy": {"type": "string", "minLength": 1},
          "analogy_limits": {"type": "string", "minLength": 1},
          "not_to_confuse_with": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/termId"}},
          "common_misuses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["statement", "correction"],
              "properties": {
                "statement": {"$ref": "#/$defs/nonEmpty"},
                "correction": {"$ref": "#/$defs/nonEmpty"}
              }
            }
          },
          "stability": {"type": "string", "enum": ["stable", "evolving", "fast-moving"]},
          "epistemic_status": {"type": "string", "enum": ["established", "pedagogical-simplification", "debated", "model-specific", "emerging"]},
          "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceId"}},
          "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
          "reviewed_on": {"type": "string", "format": "date"},
          "notes": {"type": "string"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"pedagogical_analogy": {}},
              "required": ["pedagogical_analogy"]
            },
            "then": {"required": ["analogy_limits"]}
          }
        ]
      }
    }
  }
}
