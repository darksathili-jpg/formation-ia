{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://latent.local/schema/module.schema.json",
  "title": "LATENT V3 learning module",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "version", "title", "status", "audience", "outcomes", "evidence", "activities", "sections", "assessment", "references"],
  "properties": {
    "moduleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["draft", "design-ready", "pilot-ready", "novice-ready", "needs-remediation", "retired"]},
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track", "prerequisites"],
      "properties": {
        "track": {"enum": ["discover", "practice", "deepen"]},
        "prerequisites": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "estimatedMinutes": {"type": "integer", "minimum": 5, "maximum": 600},
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "observable", "misconceptions"],
        "properties": {
          "id": {"type": "string", "minLength": 2},
          "statement": {"type": "string", "minLength": 10},
          "observable": {"type": "string", "minLength": 10},
          "misconceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "remediationActivityId"],
              "properties": {
                "id": {"type": "string"},
                "label": {"type": "string"},
                "remediationActivityId": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcomeId", "claim", "observable", "taskIds"],
        "properties": {
          "id": {"type": "string"},
          "outcomeId": {"type": "string"},
          "claim": {"type": "string", "minLength": 10},
          "observable": {"type": "string", "minLength": 10},
          "taskIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "invalidEvidence": {"type": "array", "items": {"type": "string"}},
          "rubric": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {"type": "string"},
                {"type": "number"},
                {"type": "boolean"}
              ]
            }
          }
        }
      }
    },
    "sharedActivityIds": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
      "uniqueItems": true
    },
    "activities": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "purpose", "evidenceIds", "config"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "enum": [
              "prediction-cards", "component-builder", "rank-order", "worked-example",
              "completion", "self-explanation", "quiz", "transfer-cards", "tokenizer-lab",
              "vector-lab", "parameter-lab", "attention-lab", "position-lab", "transformer-block-lab", "kv-cache-lab",
              "sampling-lab", "truth-temperature-lab", "autoregressive-lab",
              "retrieval-lab", "evidence-lab", "eval-lab"
            ]
          },
          "purpose": {"enum": ["acquire", "practice", "remediate", "retrieve", "transfer", "assess"]},
          "evidenceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "config": {"type": "object"},
          "analytics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "activityIds"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "activityIds": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["masteryPolicy", "quizActivityId", "transferActivityId"],
      "properties": {
        "masteryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["quizThreshold", "transferThreshold"],
          "properties": {
            "quizThreshold": {"type": "number", "minimum": 0, "maximum": 1},
            "transferThreshold": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "quizActivityId": {"type": "string"},
        "transferActivityId": {"type": "string"}
      }
    },
    "pedagogy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstMeaningfulActionTargetWords": {"type": "integer", "minimum": 1, "maximum": 1000},
        "minimumMeaningfulManipulations": {"type": "integer", "minimum": 1},
        "fieldValidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"enum": ["not-required", "pending", "passed", "failed"]},
            "evidenceRef": {"type": "string"}
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri"}
        }
      }
    }
  }
}
